{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dsh-robotics.local/protocol/0.1/protocol.bundle.json",
  "title": "DSH Robotics protocol",
  "description": "Generated from python/robotics_protocol. Lengths are metres, angles radians, time seconds, quaternions xyzw and normalized. Unknown fields are rejected.",
  "x-protocol-version": "0.1",
  "$defs": {
    "BackendCapabilities": {
      "additionalProperties": false,
      "properties": {
        "backend_id": {
          "pattern": "^backend_[a-z0-9_-]{3,48}$",
          "title": "Backend Id",
          "type": "string"
        },
        "backend_kind": {
          "$ref": "#/$defs/BackendKind"
        },
        "schema_version": {
          "const": "0.1",
          "default": "0.1",
          "title": "Schema Version",
          "type": "string"
        },
        "protocol_version": {
          "const": "0.1",
          "default": "0.1",
          "title": "Protocol Version",
          "type": "string"
        },
        "generated_at": {
          "format": "date-time",
          "title": "Generated At",
          "type": "string"
        },
        "updated_at": {
          "format": "date-time",
          "title": "Updated At",
          "type": "string"
        },
        "physics": {
          "$ref": "#/$defs/PhysicsInfo"
        },
        "renderer": {
          "$ref": "#/$defs/RendererInfo"
        },
        "visualizer": {
          "$ref": "#/$defs/VisualizerInfo"
        },
        "installed": {
          "title": "Installed",
          "type": "boolean"
        },
        "verified": {
          "title": "Verified",
          "type": "boolean"
        },
        "evidence": {
          "items": {
            "type": "string"
          },
          "maxItems": 64,
          "title": "Evidence",
          "type": "array"
        },
        "combinations": {
          "items": {
            "$ref": "#/$defs/CapabilityCombination"
          },
          "maxItems": 128,
          "title": "Combinations",
          "type": "array"
        }
      },
      "required": [
        "backend_id",
        "backend_kind",
        "generated_at",
        "updated_at",
        "physics",
        "renderer",
        "visualizer",
        "installed",
        "verified"
      ],
      "title": "BackendCapabilities",
      "type": "object"
    },
    "BackendKind": {
      "enum": [
        "mock",
        "isaaclab_physx",
        "isaaclab_newton"
      ],
      "title": "BackendKind",
      "type": "string"
    },
    "CameraConfig": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "width": {
          "maximum": 4096,
          "minimum": 16,
          "title": "Width",
          "type": "integer"
        },
        "height": {
          "maximum": 4096,
          "minimum": 16,
          "title": "Height",
          "type": "integer"
        },
        "update_period_s": {
          "exclusiveMinimum": 0.0,
          "maximum": 10.0,
          "title": "Update Period S",
          "type": "number"
        },
        "data_types": {
          "items": {
            "enum": [
              "rgb",
              "depth"
            ],
            "type": "string"
          },
          "maxItems": 2,
          "minItems": 1,
          "title": "Data Types",
          "type": "array"
        }
      },
      "required": [
        "name",
        "width",
        "height",
        "update_period_s",
        "data_types"
      ],
      "title": "CameraConfig",
      "type": "object"
    },
    "CapabilityCombination": {
      "additionalProperties": false,
      "properties": {
        "combination_id": {
          "pattern": "^combo_[a-z0-9_]{3,48}$",
          "title": "Combination Id",
          "type": "string"
        },
        "robot_id": {
          "pattern": "^[a-z][a-z0-9_]{1,31}$",
          "title": "Robot Id",
          "type": "string"
        },
        "task_id": {
          "pattern": "^[a-z][a-z0-9_]{2,63}$",
          "title": "Task Id",
          "type": "string"
        },
        "scene_id": {
          "pattern": "^[a-z][a-z0-9_]{1,63}$",
          "title": "Scene Id",
          "type": "string"
        },
        "backend_kind": {
          "$ref": "#/$defs/BackendKind"
        },
        "status": {
          "$ref": "#/$defs/CapabilityStatus"
        },
        "evidence": {
          "items": {
            "type": "string"
          },
          "maxItems": 64,
          "title": "Evidence",
          "type": "array"
        },
        "checked_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Checked At"
        },
        "load_error": {
          "anyOf": [
            {
              "$ref": "#/$defs/ErrorInfo"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "combination_id",
        "robot_id",
        "task_id",
        "scene_id",
        "backend_kind",
        "status"
      ],
      "title": "CapabilityCombination",
      "type": "object"
    },
    "CapabilityStatus": {
      "enum": [
        "installed",
        "verified",
        "failed",
        "unavailable"
      ],
      "title": "CapabilityStatus",
      "type": "string"
    },
    "ControlMode": {
      "enum": [
        "position",
        "velocity",
        "effort"
      ],
      "title": "ControlMode",
      "type": "string"
    },
    "EndEffectorSpec": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "parent_joint": {
          "maxLength": 96,
          "minLength": 1,
          "title": "Parent Joint",
          "type": "string"
        },
        "offset_m": {
          "default": [
            0.0,
            0.0,
            0.0
          ],
          "description": "3-D vector in metres, frame declared by the containing pose.",
          "maxItems": 3,
          "minItems": 3,
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "title": "Offset M",
          "type": "array"
        }
      },
      "required": [
        "name",
        "parent_joint"
      ],
      "title": "EndEffectorSpec",
      "type": "object"
    },
    "ErrorCode": {
      "enum": [
        "INVALID_REQUEST",
        "UNSUPPORTED_BACKEND",
        "UNSUPPORTED_CAPABILITY",
        "ASSET_NOT_READY",
        "UNREACHABLE",
        "GRASP_FAILED",
        "PLACEMENT_FAILED",
        "STALE_WORLD_STATE",
        "CONTROL_BUSY",
        "LIMIT_VIOLATION",
        "WORKER_LOST",
        "TIMEOUT",
        "MOCK_NOT_VERIFIED",
        "NOT_IMPLEMENTED"
      ],
      "title": "ErrorCode",
      "type": "string"
    },
    "ErrorInfo": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "$ref": "#/$defs/ErrorCode"
        },
        "message": {
          "maxLength": 2000,
          "minLength": 1,
          "title": "Message",
          "type": "string"
        },
        "retryable": {
          "default": false,
          "title": "Retryable",
          "type": "boolean"
        },
        "details": {
          "additionalProperties": true,
          "title": "Details",
          "type": "object"
        },
        "evidence": {
          "items": {
            "type": "string"
          },
          "maxItems": 64,
          "title": "Evidence",
          "type": "array"
        },
        "occurred_at": {
          "format": "date-time",
          "title": "Occurred At",
          "type": "string"
        }
      },
      "required": [
        "code",
        "message",
        "occurred_at"
      ],
      "title": "ErrorInfo",
      "type": "object"
    },
    "Frame": {
      "enum": [
        "world",
        "robot_base",
        "tool0",
        "camera"
      ],
      "title": "Frame",
      "type": "string"
    },
    "GpuInfo": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "memory_mib": {
          "maximum": 1048576,
          "minimum": 1,
          "title": "Memory Mib",
          "type": "integer"
        },
        "driver": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Driver",
          "type": "string"
        }
      },
      "required": [
        "name",
        "memory_mib",
        "driver"
      ],
      "title": "GpuInfo",
      "type": "object"
    },
    "GripperSpec": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "default": "none",
          "enum": [
            "parallel",
            "single",
            "none"
          ],
          "title": "Kind",
          "type": "string"
        },
        "joint_names": {
          "items": {
            "type": "string"
          },
          "maxItems": 8,
          "title": "Joint Names",
          "type": "array"
        },
        "open_value": {
          "default": 0.0,
          "title": "Open Value",
          "type": "number"
        },
        "close_value": {
          "default": 0.0,
          "title": "Close Value",
          "type": "number"
        },
        "max_width_m": {
          "default": 0.0,
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Max Width M",
          "type": "number"
        }
      },
      "title": "GripperSpec",
      "type": "object"
    },
    "GripperState": {
      "additionalProperties": false,
      "properties": {
        "width_m": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Width M",
          "type": "number"
        },
        "closed": {
          "title": "Closed",
          "type": "boolean"
        }
      },
      "required": [
        "width_m",
        "closed"
      ],
      "title": "GripperState",
      "type": "object"
    },
    "JobEvent": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "0.1",
          "default": "0.1",
          "title": "Schema Version",
          "type": "string"
        },
        "request_id": {
          "anyOf": [
            {
              "pattern": "^req_[0-9a-f-]{8,36}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Request Id"
        },
        "trace_id": {
          "anyOf": [
            {
              "pattern": "^trace_[0-9a-f-]{8,36}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Trace Id"
        },
        "job_id": {
          "pattern": "^job_[0-9a-f-]{8,36}$",
          "title": "Job Id",
          "type": "string"
        },
        "event_seq": {
          "minimum": 0,
          "title": "Event Seq",
          "type": "integer"
        },
        "at": {
          "format": "date-time",
          "title": "At",
          "type": "string"
        },
        "type": {
          "$ref": "#/$defs/JobEventType"
        },
        "status": {
          "$ref": "#/$defs/JobStatus"
        },
        "skill": {
          "anyOf": [
            {
              "pattern": "^[a-z][a-z0-9_]{2,40}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Skill"
        },
        "message": {
          "anyOf": [
            {
              "maxLength": 2000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Message"
        },
        "progress": {
          "anyOf": [
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Progress"
        },
        "data": {
          "additionalProperties": true,
          "title": "Data",
          "type": "object"
        },
        "evidence": {
          "items": {
            "type": "string"
          },
          "maxItems": 64,
          "title": "Evidence",
          "type": "array"
        }
      },
      "required": [
        "job_id",
        "event_seq",
        "at",
        "type",
        "status"
      ],
      "title": "JobEvent",
      "type": "object"
    },
    "JobEventType": {
      "enum": [
        "created",
        "started",
        "progress",
        "skill_started",
        "skill_finished",
        "verifying",
        "succeeded",
        "failed",
        "cancel_requested",
        "canceled",
        "log",
        "frame"
      ],
      "title": "JobEventType",
      "type": "string"
    },
    "JobStatus": {
      "enum": [
        "pending",
        "running",
        "canceling",
        "succeeded",
        "failed",
        "canceled"
      ],
      "title": "JobStatus",
      "type": "string"
    },
    "JointSpec": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "maxLength": 96,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "logical_name": {
          "pattern": "^[a-z][a-z0-9_]{1,48}$",
          "title": "Logical Name",
          "type": "string"
        },
        "type": {
          "$ref": "#/$defs/JointType"
        },
        "unit": {
          "enum": [
            "rad",
            "m"
          ],
          "title": "Unit",
          "type": "string"
        },
        "lower": {
          "title": "Lower",
          "type": "number"
        },
        "upper": {
          "title": "Upper",
          "type": "number"
        },
        "home": {
          "title": "Home",
          "type": "number"
        },
        "velocity_limit": {
          "exclusiveMinimum": 0,
          "title": "Velocity Limit",
          "type": "number"
        }
      },
      "required": [
        "name",
        "logical_name",
        "type",
        "unit",
        "lower",
        "upper",
        "home",
        "velocity_limit"
      ],
      "title": "JointSpec",
      "type": "object"
    },
    "JointType": {
      "enum": [
        "revolute",
        "prismatic",
        "fixed"
      ],
      "title": "JointType",
      "type": "string"
    },
    "ObjectState": {
      "additionalProperties": false,
      "properties": {
        "object_id": {
          "pattern": "^[a-z][a-z0-9_]{1,31}$",
          "title": "Object Id",
          "type": "string"
        },
        "pose": {
          "$ref": "#/$defs/Pose"
        },
        "size_m": {
          "description": "3-D vector in metres, frame declared by the containing pose.",
          "maxItems": 3,
          "minItems": 3,
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "title": "Size M",
          "type": "array"
        },
        "grasped_by": {
          "anyOf": [
            {
              "pattern": "^[a-z][a-z0-9_]{1,31}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Grasped By"
        },
        "visible": {
          "default": true,
          "title": "Visible",
          "type": "boolean"
        }
      },
      "required": [
        "object_id",
        "pose",
        "size_m"
      ],
      "title": "ObjectState",
      "type": "object"
    },
    "ObservationSource": {
      "enum": [
        "sim_ground_truth",
        "vision",
        "estimator",
        "mixed"
      ],
      "title": "ObservationSource",
      "type": "string"
    },
    "PhysicsConfig": {
      "additionalProperties": false,
      "properties": {
        "engine": {
          "enum": [
            "physx",
            "newton"
          ],
          "title": "Engine",
          "type": "string"
        },
        "dt": {
          "exclusiveMinimum": 0.0,
          "maximum": 0.1,
          "title": "Dt",
          "type": "number"
        },
        "decimation": {
          "maximum": 32,
          "minimum": 1,
          "title": "Decimation",
          "type": "integer"
        },
        "solver_iterations": {
          "maximum": 64,
          "minimum": 1,
          "title": "Solver Iterations",
          "type": "integer"
        }
      },
      "required": [
        "engine",
        "dt",
        "decimation",
        "solver_iterations"
      ],
      "title": "PhysicsConfig",
      "type": "object"
    },
    "PhysicsInfo": {
      "additionalProperties": false,
      "properties": {
        "engine": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Engine",
          "type": "string"
        },
        "version": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Version",
          "type": "string"
        },
        "deterministic": {
          "title": "Deterministic",
          "type": "boolean"
        }
      },
      "required": [
        "engine",
        "version",
        "deterministic"
      ],
      "title": "PhysicsInfo",
      "type": "object"
    },
    "PlanStep": {
      "additionalProperties": false,
      "properties": {
        "step_id": {
          "pattern": "^step_[a-z0-9_]{1,40}$",
          "title": "Step Id",
          "type": "string"
        },
        "skill": {
          "pattern": "^[a-z][a-z0-9_]{2,40}$",
          "title": "Skill",
          "type": "string"
        },
        "parameters": {
          "additionalProperties": true,
          "title": "Parameters",
          "type": "object"
        },
        "depends_on": {
          "items": {
            "pattern": "^step_[a-z0-9_]{1,40}$",
            "type": "string"
          },
          "maxItems": 32,
          "title": "Depends On",
          "type": "array"
        },
        "expected_duration_s": {
          "exclusiveMinimum": 0.0,
          "maximum": 600.0,
          "title": "Expected Duration S",
          "type": "number"
        }
      },
      "required": [
        "step_id",
        "skill",
        "expected_duration_s"
      ],
      "title": "PlanStep",
      "type": "object"
    },
    "Pose": {
      "additionalProperties": false,
      "properties": {
        "frame": {
          "$ref": "#/$defs/Frame"
        },
        "frame_id": {
          "anyOf": [
            {
              "maxLength": 64,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Frame Id"
        },
        "position": {
          "description": "3-D vector in metres, frame declared by the containing pose.",
          "maxItems": 3,
          "minItems": 3,
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "title": "Position",
          "type": "array"
        },
        "orientation_xyzw": {
          "description": "Normalized quaternion in xyzw order.",
          "maxItems": 4,
          "minItems": 4,
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "title": "Orientation Xyzw",
          "type": "array"
        }
      },
      "required": [
        "frame",
        "position",
        "orientation_xyzw"
      ],
      "title": "Pose",
      "type": "object"
    },
    "PredicateKind": {
      "enum": [
        "object_in_region",
        "object_height",
        "robot_released",
        "gripper_width",
        "object_pose",
        "custom"
      ],
      "title": "PredicateKind",
      "type": "string"
    },
    "PythonRuntime": {
      "additionalProperties": false,
      "properties": {
        "version": {
          "maxLength": 32,
          "minLength": 3,
          "title": "Version",
          "type": "string"
        },
        "executable": {
          "maxLength": 1024,
          "minLength": 1,
          "title": "Executable",
          "type": "string"
        },
        "platform": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Platform",
          "type": "string"
        }
      },
      "required": [
        "version",
        "executable",
        "platform"
      ],
      "title": "PythonRuntime",
      "type": "object"
    },
    "Region3D": {
      "additionalProperties": false,
      "properties": {
        "min": {
          "description": "3-D vector in metres, frame declared by the containing pose.",
          "maxItems": 3,
          "minItems": 3,
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "title": "Min",
          "type": "array"
        },
        "max": {
          "description": "3-D vector in metres, frame declared by the containing pose.",
          "maxItems": 3,
          "minItems": 3,
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "title": "Max",
          "type": "array"
        }
      },
      "required": [
        "min",
        "max"
      ],
      "title": "Region3D",
      "type": "object"
    },
    "RendererConfig": {
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "title": "Enabled",
          "type": "boolean"
        },
        "headless": {
          "title": "Headless",
          "type": "boolean"
        },
        "backend": {
          "anyOf": [
            {
              "maxLength": 64,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Backend"
        },
        "cameras": {
          "items": {
            "$ref": "#/$defs/CameraConfig"
          },
          "maxItems": 8,
          "title": "Cameras",
          "type": "array"
        }
      },
      "required": [
        "enabled",
        "headless"
      ],
      "title": "RendererConfig",
      "type": "object"
    },
    "RendererInfo": {
      "additionalProperties": false,
      "properties": {
        "enabled": {
