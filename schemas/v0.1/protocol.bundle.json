          "minLength": 1,
          "title": "Log Dir",
          "type": "string"
        },
        "num_envs": {
          "maximum": 64,
          "minimum": 1,
          "title": "Num Envs",
          "type": "integer"
        },
        "device": {
          "pattern": "^(cpu|cuda(:\\d+)?)$",
          "title": "Device",
          "type": "string"
        }
      },
      "required": [
        "cwd",
        "log_dir",
        "num_envs",
        "device"
      ],
      "title": "WorkerRuntime",
      "type": "object"
    },
    "WorldState": {
      "additionalProperties": false,
      "properties": {
        "simulation_id": {
          "pattern": "^sim_[0-9a-f-]{8,36}$",
          "title": "Simulation Id",
          "type": "string"
        },
        "episode_id": {
          "pattern": "^ep_[0-9a-f-]{8,36}$",
          "title": "Episode Id",
          "type": "string"
        },
        "env_id": {
          "maximum": 63,
          "minimum": 0,
          "title": "Env Id",
          "type": "integer"
        },
        "state_version": {
          "minimum": 0,
          "title": "State Version",
          "type": "integer"
        },
        "event_seq": {
          "minimum": 0,
          "title": "Event Seq",
          "type": "integer"
        },
        "sim_step": {
          "minimum": 0,
          "title": "Sim Step",
          "type": "integer"
        },
        "sim_time_s": {
          "minimum": 0.0,
          "title": "Sim Time S",
          "type": "number"
        },
        "wall_time": {
          "format": "date-time",
          "title": "Wall Time",
          "type": "string"
        },
        "source": {
          "$ref": "#/$defs/ObservationSource"
        },
        "frame": {
          "$ref": "#/$defs/Frame",
          "default": "world"
        },
        "robots": {
          "items": {
            "$ref": "#/$defs/RobotState"
          },
          "maxItems": 8,
          "minItems": 1,
          "title": "Robots",
          "type": "array"
        },
        "objects": {
          "items": {
            "$ref": "#/$defs/ObjectState"
          },
          "maxItems": 256,
          "title": "Objects",
          "type": "array"
        },
        "skills": {
          "items": {
            "$ref": "#/$defs/SkillStatus"
          },
          "maxItems": 64,
          "title": "Skills",
          "type": "array"
        }
      },
      "required": [
        "simulation_id",
        "episode_id",
        "env_id",
        "state_version",
        "event_seq",
        "sim_step",
        "sim_time_s",
        "wall_time",
        "source",
        "robots"
      ],
      "title": "WorldState",
      "type": "object"
    }
  }
}
